{
  "name": "NineCafe (.NET 9)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-9.0-bookworm",
  "remoteEnv": {
    "DatabaseProvider": "Sqlite",
    "ConnectionStrings__DefaultConnection": "Data Source=ninecafe.db"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit"
      ]
    }
  },
  "forwardPorts": [5208],
  "portsAttributes": {
    "5208": {
      "label": "NineCafe App (HTTP)",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "dotnet restore NineCafeProductApp.sln && dotnet tool install --global dotnet-ef"
}